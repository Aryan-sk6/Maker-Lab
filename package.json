{
  "name": "maker-lab",
  "version": "0.3.0",
  "description": "Maker Lab: an MCP Apps server with a 3D model viewer, a physics/maths sandbox and a molecule viewer.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:widgets": "node widgets/build.mjs",
    "build": "npm run build:widgets && tsc -p tsconfig.build.json",
    "start": "node dist/server/index.js",
    "dev": "npm run build:widgets && tsx watch server/index.ts",
    "tunnel": "cloudflared tunnel --url http://localhost:8787",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "3dmol": "2.5.5",
    "express": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "three": "0.186.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
